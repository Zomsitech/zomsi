---
import RummyScoreLayout from "../../layouts/RummyScoreLayout.astro";
import "../../styles/rummyscore-marketing.css";

const steps = [
  {
    number: "01",
    title: "Track every game in one place",
    text: "Dashboard, recent sessions, player roster, and quick actions — everything you need the moment you open the app.",
    image: "/rummyscore-marketing/01-dashboard.webp",
  },
  {
    number: "02",
    title: "Start a new game in seconds",
    text: "Set rules, pick players, and organize the match instantly — no paper score sheet to draw up first.",
    image: "/rummyscore-marketing/02-new-game.webp",
  },
  {
    number: "03",
    title: "Score rounds with speed and clarity",
    text: "Quick score actions, live standings, and a complete-game flow that keeps every player's total current.",
    image: "/rummyscore-marketing/03-score-round.webp",
  },
  {
    number: "04",
    title: "Invite friends and share instantly",
    text: "Use invite codes, share links, or a QR code, and keep everyone in sync on the same scoreboard.",
    image: "/rummyscore-marketing/04-share-invite.webp",
  },
  {
    number: "05",
    title: "Never lose your rummy history",
    text: "Review past matches, manage saved players, and plan future game nights — all kept together.",
    image: "/rummyscore-marketing/05-history-events.webp",
  },
];

const features = [
  ["⚡", "Fast score entry", "Record show, middle drop, wrong show, full count, or a custom score without slowing down the game."],
  ["∑", "Automatic totals", "Running totals update automatically after every round so nobody has to calculate points by hand."],
  ["⌘", "Flexible rules", "Configure target score and common scoring values to match the way your family or group plays."],
  ["↺", "Game history", "Keep completed rounds and saved games together instead of losing paper score sheets."],
  ["◎", "Made for game night", "A focused scorekeeping experience for Indian Rummy with friends and family — not a casino or wagering product."],
  ["↗", "Live on the web now", "The web app is live today at rummyscore.zomsi.co — no install needed. iOS and Android apps are on the way."],
];
---

<RummyScoreLayout
  title="Rummy Score — Indian Rummy Scorekeeper"
  description="Rummy Score is a fast, flexible Indian Rummy scorekeeper for games with friends and family. Set players and rules, score every round, and keep automatic totals and game history."
>
  <main class="rs-page">
    <section class="rs-hero">
      <div class="container rs-hero-grid">
        <div class="rs-hero-copy">
          <a class="rs-live-badge" href="https://rummyscore.zomsi.co/">
            <span class="rs-live-dot"></span>Web app is live — play right in your browser
          </a>
          <span class="rs-kicker">Rummy Score · by Zomsi</span>
          <h1>Ready for<br /><span>Rummy Night?</span></h1>
          <p class="rs-hero-lead">
            A clean digital scoreboard built for Indian Rummy nights. Set your players and rules, score every round in seconds, and let Rummy Score handle the totals.
          </p>
          <div class="rs-actions">
            <a class="button primary rs-primary" href="https://rummyscore.zomsi.co/">Start</a>
            <a class="button secondary rs-secondary" href="#how-it-works">See how it works</a>
          </div>
          <div class="rs-proof-row" aria-label="Rummy Score highlights">
            <span><strong>No paper</strong><small>One shared scoreboard</small></span>
            <span><strong>No math</strong><small>Automatic totals</small></span>
            <span><strong>No betting</strong><small>Scorekeeping only</small></span>
          </div>
        </div>

        <div class="rs-hero-visual" aria-label="Rummy Score round-entry preview">
          <div class="rs-orb rs-orb-one"></div>
          <div class="rs-orb rs-orb-two"></div>
          <div class="rs-phone rs-phone-hero">
            <div class="rs-status"><span>9:41</span><span>▮▮ ◔ ▰</span></div>
            <div class="rs-appbar">
              <div><span class="rs-round-pill">Round 5</span><h3>Sunday Rummy</h3></div>
              <span class="rs-remaining">4 Players Remaining</span>
            </div>
            <div class="rs-tabs"><strong>Round Entry</strong><span>Leaderboard</span><span>History</span></div>
            <div class="rs-player winner"><span class="rs-avatar green">AM</span><span><b>Amit</b><small>Winner (Show)</small></span><strong>140<small>Total</small></strong></div>
            <div class="rs-player"><span class="rs-avatar">RJ</span><span><b>Raj</b><small>Middle Drop (+50)</small></span><strong>185<small>Total</small></strong></div>
            <div class="rs-player"><span class="rs-avatar">SN</span><span><b>Sonia</b><small>Custom: 45</small></span><strong>215<small>Total</small></strong></div>
            <div class="rs-player"><span class="rs-avatar">KN</span><span><b>Kunal</b><small>Enter Score</small></span><strong>95<small>Total</small></strong></div>
            <button class="rs-submit" type="button">Submit Round</button>
            <div class="rs-home-indicator"></div>
          </div>
          <div class="rs-float-card rs-float-top"><span>♥</span><strong>13</strong><small>cards</small></div>
          <div class="rs-float-card rs-float-bottom"><span>✓</span><strong>Auto</strong><small>totals</small></div>
        </div>
      </div>
    </section>

    <section class="rs-intro section">
      <div class="container rs-section-head">
        <span class="rs-kicker dark">Built for the table</span>
        <h2>Everything your score sheet should have been.</h2>
        <p>Rummy Score stays out of the way while the game is happening, then keeps the details you actually want once the round is over.</p>
      </div>
      <div class="container rs-feature-grid">
        {features.map(([icon, title, text]) => (
          <article class="rs-feature-card">
            <span class="rs-feature-icon">{icon}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="rs-story section" id="how-it-works">
      <div class="container rs-section-head rs-section-head-light">
        <span class="rs-kicker">From first deal to final winner</span>
        <h2>See Rummy Score in action.</h2>
        <p>Real screens from the app — the same flow you'll use from your first game to your fiftieth.</p>
      </div>

      <div class="container rs-story-list">
        {steps.map((step, index) => (
          <article class={`rs-story-row ${index % 2 ? "reverse" : ""}`}>
            <div class="rs-story-copy">
              <span class="rs-step-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
            <div class="rs-marketing-shot">
              <img src={step.image} alt={step.title} loading="lazy" width="941" height="1672" />
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="rs-utility section">
      <div class="container rs-utility-card">
        <div>
          <span class="rs-kicker dark">Scorekeeping, not gambling</span>
          <h2>Made for rummy nights with friends and family.</h2>
          <p>Rummy Score is a scorekeeping utility. It does not provide betting, wagering, cash gameplay, or real-money gaming. The app helps your group track the game you are already playing.</p>
        </div>
        <div class="rs-card-fan" aria-hidden="true">
          <span class="card c1">A<b>♠</b></span>
          <span class="card c2">7<b>♥</b></span>
          <span class="card c3">K<b>♣</b></span>
          <span class="card c4">10<b>♦</b></span>
        </div>
      </div>
    </section>

    <section class="rs-download section" id="download">
      <div class="container rs-download-card">
        <div>
          <span class="rs-kicker">Rummy Score</span>
          <h2>Put away the score sheet.</h2>
          <p>Keep the cards. Keep the competition. Let Rummy Score handle the scoring.</p>
        </div>
        <div class="rs-download-actions">
          <a class="button rs-store-button" href="#" aria-label="App Store link placeholder"><small>Download on the</small><strong>App Store</strong></a>
          <a class="button rs-store-button" href="#" aria-label="Google Play link placeholder"><small>Get it on</small><strong>Google Play</strong></a>
          <a class="button rs-web-button" href="https://rummyscore.zomsi.co/">Open Web App<span class="rs-live-chip">Live</span></a>
        </div>
        <p class="rs-placeholder-note">The web app is live today — App Store and Google Play links are placeholders until those listings are ready.</p>
      </div>
    </section>
  </main>
</RummyScoreLayout>
