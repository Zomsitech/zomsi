---
import RummyScoreLayout from "../../layouts/RummyScoreLayout.astro";
---
<RummyScoreLayout title="Rummy Score — Indian Rummy Scorekeeper" description="Rummy Score is a simple scorekeeper for Indian Rummy games with friends and family.">
<main>
<section class="hero"><div class="container"><span class="eyebrow">Rummy Score</span><h1 style="max-width:980px;margin-top:18px">Play more.<br />Calculate less.</h1><p class="lead">Rummy Score replaces paper score sheets with a simple digital scoreboard designed for Indian Rummy games with family and friends.</p><div class="hero-actions"><a class="button primary" href="#download">Get Rummy Score</a><a class="button secondary" href="/rummyscore/support">Support</a></div></div></section>
<section class="section"><div class="container"><div class="grid">
  <div class="card feature"><h3>Fast score entry</h3><p>Record show, middle drop, wrong show, full count, or custom scores.</p></div>
  <div class="card feature"><h3>Automatic totals</h3><p>Running totals update automatically so you can focus on the game.</p></div>
  <div class="card feature"><h3>Flexible rules</h3><p>Customize target score and major scoring values to match how your group plays.</p></div>
  <div class="card feature"><h3>Game history</h3><p>Review completed rounds and saved games without paper records.</p></div>
  <div class="card feature"><h3>Cross-platform</h3><p>Available across iOS, Android, and Web.</p></div>
  <div class="card feature"><h3>No real-money gaming</h3><p>Rummy Score is a scorekeeping utility only. It does not provide betting or wagering.</p></div>
</div></div></section>
<section class="section" id="download"><div class="container"><div class="card"><span class="eyebrow">Available now</span><h2 style="margin-top:16px">Choose your platform.</h2><p style="color:var(--muted)">Replace these placeholder links with your real App Store, Google Play, and web URLs.</p><div class="hero-actions"><a class="button primary" href="#">App Store</a><a class="button secondary" href="#">Google Play</a><a class="button secondary" href="#">Open Web App</a></div></div></div></section>
</main>
</RummyScoreLayout>
