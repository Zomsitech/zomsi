---
import "../../styles/global.css";
const dest = "https://rummyscore.zomsi.co/support";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta http-equiv="refresh" content={`0; url=${dest}`} />
  <link rel="canonical" href={dest} />
  <title>Rummy Score Support has moved — Zomsi</title>
</head>
<body>
  <main class="section"><div class="container legal-copy">
    <span class="eyebrow">Rummy Score support</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);margin-top:18px">This page has moved</h1>
    <p class="lead">Rummy Score Support now lives at its own address. Redirecting you now — if nothing happens, <a href={dest}>continue to {dest}</a>.</p>
  </div></main>
</body>
</html>
