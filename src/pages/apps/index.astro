---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Apps — Zomsi" description="Explore apps built by Zomsi.">
<main class="section"><div class="container">
  <span class="eyebrow">Products</span><h1 style="font-size:clamp(2.8rem,6vw,5rem);margin-top:18px">Apps by Zomsi</h1>
  <p class="lead">Focused products built to solve practical problems with less friction.</p>
  <div class="grid" style="margin-top:38px"><article class="card app-card"><div>
    <span class="eyebrow">Available now</span><h2 style="margin-top:16px">Rummy Score</h2>
    <p class="lead" style="font-size:1.12rem">Indian Rummy scorekeeping for friends and family.</p>
    <p style="color:var(--muted)">Create games, add players, enter round scores, manage drops and wrong shows, review history, and see the final winner.</p>
    <div class="pill-row"><span class="pill">iOS</span><span class="pill">Android</span><span class="pill">Web</span></div>
    <a class="button primary" href="/rummyscore">Learn More</a>
  </div><div class="app-art has-icon"><img src="/icons/rummyscore-icon.png" alt="Rummy Score app icon" /></div></article></div>
</div></main>
</Layout>
