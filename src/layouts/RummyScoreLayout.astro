---
import "../styles/global.css";
const { title = "Rummy Score", description = "Rummy Score is a simple scorekeeper for Indian Rummy games with friends and family." } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, "https://zomsi.co").toString();
const socialImage = new URL("/rummyscore-marketing/06-app-promo.webp", "https://zomsi.co").toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/png" href="/icons/rummyscore-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Rummy Score" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:width" content="1254" />
  <meta property="og:image:height" content="1254" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <title>{title}</title>
  <style>
    .brand-text { display: flex; flex-direction: column; line-height: 1.2; }
    .brand-text strong { font-weight: 800; }
    .brand-text small { font-weight: 600; color: var(--muted); font-size: 0.72rem; letter-spacing: 0.01em; }
    @media (max-width: 720px) {
      .brand-text small { display: none; }
      .nav-actions .button.secondary { display: none; }
      .nav-actions .button.primary { padding: 0 16px; }
    }
    @media (max-width: 420px) {
      img.brand-mark.store { width: 38px; height: 38px; }
      .brand-text strong { font-size: 0.95rem; }
    }
  </style>
</head>
<body>
<header class="nav-shell">
  <div class="container nav">
    <a class="brand" href="/rummyscore">
      <img class="brand-mark store" src="/icons/rummyscore-icon-playstore.png" alt="" width="48" height="48" />
      <span class="brand-text"><strong>Rummy Score</strong><small>Smart scoreboard for Indian Rummy</small></span>
    </a>
    <nav class="nav-links" aria-label="Primary navigation">
      <a href="/rummyscore">Home</a><a href="/rummyscore/support">Support</a><a href="/rummyscore/privacy">Privacy</a><a href="/">By Zomsi</a>
    </nav>
    <div class="nav-actions">
      <a class="button secondary" href="/rummyscore#download">Get Mobile App</a>
      <a class="button primary" href="https://rummyscore.zomsi.co/">Start</a>
    </div>
  </div>
</header>
<slot />
<footer class="footer">
  <div class="container footer-row">
    <div><strong>Rummy Score</strong><br /><span>An app by Zomsi Info Tech Private Limited</span></div>
    <div class="footer-links"><a href="/rummyscore">Home</a><a href="/rummyscore/support">Support</a><a href="/rummyscore/privacy">Privacy</a><a href="/">zomsi.co</a><a href="https://www.linkedin.com/company/zomsi" target="_blank" rel="noreferrer">LinkedIn</a></div>
    <div>© 2026 Zomsi. All rights reserved.</div>
  </div>
</footer>
</body>
</html>
